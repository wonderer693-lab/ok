---
import BaseLayout from '../layouts/BaseLayout.astro';
import SalesTable from '../components/SalesTable.astro';
import raw from '../data/sales.json';
import { formatUSD, formatDate, sortByDateDesc, sortByPriceDesc, type Sale } from '../lib/format';

const sales = raw as Sale[];
const latest = [...sales].sort(sortByDateDesc);
const top = [...sales].sort(sortByPriceDesc);
const totalVolume = sales.reduce((sum, sale) => sum + sale.price, 0);
const tracked = sales.length;
const lastUpdated = latest[0]?.date ?? null;
---

<BaseLayout
  title="LiveSellSI — Verified .si Domain Sales"
  description="Tracked .si domain sales: price, venue, date and category for every publicly reported Slovenian TLD aftermarket transaction."
>
  <section class="border-b border-neutral-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
            Verified <span class="text-emerald-700">.si</span> domain sales
          </h1>
          <p class="mt-1 text-sm text-neutral-500">
            Public aftermarket data for the Slovenian country-code TLD. Pipeline runs every 12h.
            {lastUpdated && <>Last record: {formatDate(lastUpdated)}.</>}
          </p>
        </div>
        <dl class="flex gap-8 font-mono">
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-neutral-400">Total Volume</dt>
            <dd class="text-xl font-bold tabular-nums text-emerald-700">{formatUSD(totalVolume)}</dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-neutral-400">Tracked Sales</dt>
            <dd class="text-xl font-bold tabular-nums text-neutral-900">{tracked}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div
        class="inline-flex rounded-md border border-neutral-300 bg-white p-0.5"
        role="tablist"
        aria-label="Sales view"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-tab="latest"
          class="tab-btn tab-active rounded px-4 py-1.5 font-mono text-sm font-semibold"
        >
          Latest Sales
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-tab="top"
          class="tab-btn rounded px-4 py-1.5 font-mono text-sm font-semibold"
        >
          Top Sales
        </button>
      </div>
      <label class="relative block sm:w-72">
        <span class="sr-only">Search domains</span>
        <input
          id="search"
          type="search"
          placeholder="Filter by domain… e.g. avto"
          autocomplete="off"
          class="w-full rounded-md border border-neutral-300 bg-white px-3 py-1.5 font-mono text-sm placeholder:text-neutral-400 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
        />
      </label>
    </div>

    <div data-panel="latest">
      <SalesTable id="latest" sales={latest} />
    </div>
    <div data-panel="top" hidden>
      <SalesTable id="top" sales={top} />
    </div>
    <p class="mt-3 font-mono text-xs text-neutral-400" id="result-hint" aria-live="polite"></p>
  </section>
</BaseLayout>

<script>
  const PER_PAGE = 25;
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const search = document.getElementById('search') as HTMLInputElement;
  const hint = document.getElementById('result-hint');
  const pagerState = new WeakMap<HTMLElement, { page: number }>();

  panels.forEach((panel) => pagerState.set(panel, { page: 1 }));

  function renderPager(panel: HTMLElement, page: number, pageCount: number) {
    const pager = panel.querySelector<HTMLElement>('[data-pager]');
    if (!pager) return;
    pager.hidden = pageCount <= 1;
    const label = pager.querySelector<HTMLElement>('[data-page-label]');
    if (label) label.textContent = `Page ${page} of ${pageCount}`;
    const prev = pager.querySelector<HTMLButtonElement>('[data-page-prev]');
    const next = pager.querySelector<HTMLButtonElement>('[data-page-next]');
    if (prev) prev.disabled = page <= 1;
    if (next) next.disabled = page >= pageCount;
    const numbers = pager.querySelector<HTMLElement>('[data-page-numbers]');
    if (!numbers) return;
    numbers.textContent = '';
    for (let i = 1; i <= pageCount; i += 1) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(i);
      button.className = i === page ? 'page-num page-num-active' : 'page-num';
      button.dataset.page = String(i);
      button.setAttribute('aria-label', `Page ${i}`);
      if (i === page) button.setAttribute('aria-current', 'page');
      numbers.appendChild(button);
    }
  }

  function renderPanel(panel: HTMLElement, query: string) {
    const state = pagerState.get(panel) ?? { page: 1 };
    pagerState.set(panel, state);
    const rows = Array.from(panel.querySelectorAll<HTMLTableRowElement>('tbody tr[data-domain]'));
    const matches = query ? rows.filter((row) => (row.dataset.domain ?? '').includes(query)) : rows;
    const pageCount = Math.max(1, Math.ceil(matches.length / PER_PAGE));
    state.page = Math.min(Math.max(1, state.page), pageCount);
    const pageRows = new Set(matches.slice((state.page - 1) * PER_PAGE, state.page * PER_PAGE));
    rows.forEach((row) => row.classList.toggle('hidden', !pageRows.has(row)));

    const empty = panel.querySelector<HTMLTableRowElement>('.no-results');
    if (empty) empty.classList.toggle('hidden', matches.length !== 0);

    renderPager(panel, state.page, pageCount);

    if (hint) {
      hint.textContent = query
        ? `${matches.length} result${matches.length === 1 ? '' : 's'} for "${search.value}"`
        : '';
    }
  }

  function renderActivePanel() {
    const query = search.value.trim().toLowerCase();
    panels.forEach((panel) => {
      if (!panel.hidden) renderPanel(panel, query);
    });
  }

  function setActiveTab(tab: string) {
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== tab;
    });
    tabs.forEach((button) => {
      const selected = button.dataset.tab === tab;
      button.setAttribute('aria-selected', String(selected));
      button.classList.toggle('tab-active', selected);
    });
    renderActivePanel();
  }

  function rerender(panel: HTMLElement) {
    renderPanel(panel, search.value.trim().toLowerCase());
  }

  tabs.forEach((button) =>
    button.addEventListener('click', () => setActiveTab(button.dataset.tab ?? 'latest')),
  );

  search.addEventListener('input', () => {
    panels.forEach((panel) => {
      const state = pagerState.get(panel);
      if (state) state.page = 1;
    });
    renderActivePanel();
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const panel = target.closest<HTMLElement>('[data-panel]');
    if (!panel) return;
    const state = pagerState.get(panel);
    if (!state) return;
    if (target.closest('[data-page-prev]')) {
      state.page -= 1;
      rerender(panel);
    } else if (target.closest('[data-page-next]')) {
      state.page += 1;
      rerender(panel);
    } else {
      const number = target.closest<HTMLButtonElement>('[data-page]');
      if (number) {
        state.page = Number(number.dataset.page);
        rerender(panel);
      }
    }
  });

  renderActivePanel();
</script>
